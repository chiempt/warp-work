{
  "version": "0.2.0",
  "configurations": [
    {
      // Reads infra/.env, so the debugger sees the same configuration as
      // `make run-api`. Requires a local Postgres and Redis — `make setup`.
      "name": "API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/api/cmd/api",
      "envFile": "${workspaceFolder}/infra/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Worker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/worker/cmd/worker",
      "envFile": "${workspaceFolder}/infra/.env",
      "console": "integratedTerminal"
    },
    {
      // Next.js dev server with the Node inspector attached, so breakpoints
      // work in Server Components, route handlers and middleware.
      "name": "Web (server)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/apps/web"
    },
    {
      // Breakpoints in Client Components. Start "Web (server)" first.
      "name": "Web (browser)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/web",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "turbopack://[project]/*": "${webRoot}/*"
      }
    },
    {
      // Debugs the tests in the package of the file that is open.
      "name": "Go: test package hiện tại",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "envFile": "${workspaceFolder}/infra/.env"
    },
    {
      // Debugs only the test the cursor is inside.
      "name": "Go: test tại con trỏ",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.run", "${selectedText}"],
      "envFile": "${workspaceFolder}/infra/.env"
    }
  ],
  "compounds": [
    {
      // Everything at once. stopAll means killing one stops the rest, so you
      // never leave an orphan holding :8080.
      "name": "Warp: API + Worker + Web",
      "configurations": ["API", "Worker", "Web (server)"],
      "stopAll": true
    },
    {
      "name": "Warp: API + Web",
      "configurations": ["API", "Web (server)"],
      "stopAll": true
    }
  ]
}
