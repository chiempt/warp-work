# Environment — never commit real credentials
.env
.env.*
!.env.example

# Go
/bin/
coverage.out
*.exe
*.test
*.out
vendor/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local data
/tmp/
*.db
*.sqlite

# Editors and OS
.DS_Store
.idea/
.vscode/*
# Shared editor setup: debug configs, tasks, and the settings that make
# generated code read-only. Everything else under .vscode is per-person.
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
