    USERS ||--o{ AUDIT_LOG         : owns

    CONTEXTS ||--o{ CONTEXTS              : "parent of"
    CONTEXTS ||--o{ ACCOUNT_CONTEXTS      : "fed by"
    CONTEXTS ||--o{ ROUTING_RULES         : "matched by"
    CONTEXTS ||--o{ SIGNAL_CONTEXTS       : "receives"
