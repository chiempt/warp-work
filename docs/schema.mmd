    COMMITMENTS ||--o{ REMINDERS : triggers

    MEMORY_NOTES ||--o{ MEMORY_NOTES : supersedes

    ACTION_TYPES ||--o{ RUNS             : types
    ACTION_TYPES ||--o{ PROPOSED_ACTIONS : types
    ACTION_TYPES ||--o{ AUTONOMY_RULES   : governed_by

    PROMPT_TEMPLATES ||--o{ RUNS : "instructs"

    WORK_SESSIONS ||--o{ WORK_SESSION_CONTEXTS : scopes
    WORK_SESSIONS ||--o{ RUNS                  : spawns
    WORK_SESSIONS ||--o{ REPORTS               : "closes with"

    RUNS             ||--o{ RUN_STEPS         : logs
    RUNS             ||--o{ PROPOSED_ACTIONS  : proposes
    PROPOSED_ACTIONS ||--o| EXECUTIONS        : "becomes"
