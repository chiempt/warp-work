    SIGNALS ||--o{ EVENTS          : "derived into"
    SIGNALS ||--o{ COMMITMENTS     : "evidence for"
    SIGNALS ||--o{ MEMORY_NOTES    : "source of"

    PEOPLE ||--o{ IDENTITIES  : "known as"
    PEOPLE ||--o{ COMMITMENTS : "party to"
    PEOPLE ||--o{ EVENTS      : "attends"

    TASKS       ||--o{ TASKS     : "parent of"
