# Copy to infra/.env and fill in. Never commit the filled version.
# Every variable here is parsed once at startup into a typed config struct — see
# docs/conventions.md §10.
#
# This file is both `include`d by the Makefile and `source`d by shell scripts.
# Make does not treat a trailing `# ...` as a shell comment, so an inline
# comment ends up inside the value. Keep every comment on its own line.

# --- Runtime ---------------------------------------------------------------
# APP_ENV: development | production
APP_ENV=development
API_PORT=8080
# LOG_LEVEL: debug | info | warn | error.
# Raw signal payloads are only ever logged at debug.
LOG_LEVEL=debug

# LOG_FORMAT: json | console.
# json is one event per line and is what every collector reads. console is
# coloured and aligned for a person watching a terminal. Defaults to console
# when APP_ENV=development, json otherwise — set it explicitly to reproduce
# production's exact output locally.
LOG_FORMAT=console

# --- Postgres --------------------------------------------------------------
# Written by `make db-create`, which provisions the role and generates the
# password. Postgres 17 with pgvector; the role is not a superuser.
DATABASE_URL=

# --- Redis (asynq queue) ---------------------------------------------------
# Database index 4 keeps Warp's keys away from anything else on a shared local
# Redis. asynq namespaces by key prefix, but a FLUSHDB does not.
REDIS_URL=redis://localhost:6379/4

# --- Encryption ------------------------------------------------------------
# 32-byte key, base64. Encrypts accounts.credentials_enc at rest.
# Losing this means re-authorising every connector.
CREDENTIALS_ENCRYPTION_KEY=

# --- Claude ----------------------------------------------------------------
# Tiers are fixed by ADR 0003. Override only for experiments, never to cut cost
# silently — the model is recorded on every runs row.
ANTHROPIC_API_KEY=
MODEL_ROUTING=claude-haiku-4-5
MODEL_EXTRACTION=claude-sonnet-5
MODEL_DRAFTING=claude-opus-5

# Monthly ceiling in USD. Exceeding it must degrade, not fail: routing and
# extraction continue, drafting stops and the session reports why.
# See docs/open-questions.md §5 — the number is not yet decided.
TOKEN_BUDGET_MONTHLY_USD=

# --- Google ----------------------------------------------------------------
# Sign-in works as soon as these three are filled in; nothing else to change.
#
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create credentials -> OAuth client ID -> Web application
#   3. Authorised redirect URI: exactly the GOOGLE_REDIRECT_URL below
#   4. Paste the client id and secret here and restart the api
#
# Until then GET /api/v1/auth/google/start answers 501 naming these variables,
# rather than failing as though Google were down.
#
# These scopes are identity only (openid email profile). Reading Gmail and
# Calendar is a *separate* consent that writes to accounts.credentials_enc: its
# token has to keep working unattended for months, while a session lasts only as
# long as someone is present. One consent screen for both would mean every
# sign-in re-issued the sync token, and revoking a session would stop the
# overnight sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# --- Containers (optional) -------------------------------------------------
# Only used by infra/docker-compose.yml, for machines without a local Postgres
# and Redis. The container host ports avoid 5432/6379 on purpose, so they can
# never collide with a local install.
# POSTGRES_PORT=5433
# REDIS_PORT=6380

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# Presentation-layer timezone. The database stores UTC and knows nothing about
# this.
NEXT_PUBLIC_TIMEZONE=Asia/Ho_Chi_Minh
